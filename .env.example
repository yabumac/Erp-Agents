# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Your deployed address, no trailing slash. Locally: http://localhost:3000
APP_URL=https://your-project.vercel.app
# Long random string. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Comma separated list of Google accounts allowed to sign in
ALLOWED_EMAILS=yabutech47@gmail.com
# Optional: enables Smart draft and Polish text
ANTHROPIC_API_KEY=
